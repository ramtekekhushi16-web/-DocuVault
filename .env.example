DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/docuvault
# Local Docker Compose only; use a strong unique password outside development.
POSTGRES_PASSWORD=postgres
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
DOCUVAULT_ENCRYPTION_KEY=replace-with-url-safe-base64-32-byte-key
SHARE_TOKEN_DAYS=7
MAX_DOCUMENT_BYTES=2000000